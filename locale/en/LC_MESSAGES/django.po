msgid "Le fichier Anki est illisible ou endommagé."
msgstr "The Anki file is unreadable or damaged."

#: cards/anki.py:148
#, python-format
msgid "Ce paquet contient %(count)d notes : %(max)d au maximum par import."
msgstr "This deck has %(count)d notes: %(max)d at most per import."

