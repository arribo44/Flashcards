#: cards/forms.py:25
msgid "Fichier CSV"
msgstr "CSV file"

#: cards/forms.py:27
msgid ""
"Colonnes : question, réponse et, si vous voulez, un exemple. Séparateur "
"virgule, point-virgule ou tabulation. Une ligne d'en-tête « question » est "
"ignorée."
msgstr ""
"Columns: question, answer and, optionally, an example. Separated by commas, "
"semicolons or tabs. A “question” header line is skipped."

